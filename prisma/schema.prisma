generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  lead_gen
  sdr
  closer
  manager
  hr
}

enum LeadSource {
  csv_upload
  manual
  website
  referral
  linkedin
  other
}

enum ActivityType {
  call
  email
  meeting
  note
  status_change
  stage_change
  follow_up
  linkedin
  cadence_touch
  assignment
  upload
}

enum CallOutcome {
  connected
  voicemail
  no_answer
  busy
  wrong_number
  callback_requested
  not_interested
  interested
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum MeetingStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum CallStatus {
  Completed
  Missed
  Voicemail
  Scheduled
  No_Answer
  Busy
  Failed
}

enum NotificationType {
  lead_assigned
  status_change
  call_logged
  meeting_scheduled
  task_due
  system
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  avatar              String?
  role                UserRole
  isActive            Boolean   @default(true) @map("is_active")
  phone               String?
  tokenVersion        Int       @default(0) @map("token_version")
  refreshTokens       String[]  @default([]) @map("refresh_tokens")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockUntil           DateTime? @map("lock_until")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiry    DateTime? @map("reset_token_expiry")
  teamId              String?   @map("team_id")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  team                Team?     @relation("TeamMembers", fields: [teamId], references: [id])
  managedTeams        Team[]    @relation("TeamManager")
  uploadedLeads       Lead[]    @relation("UploadedBy")
  assignedLeads       Lead[]    @relation("AssignedTo")
  activities          Activity[]
  callLogs            Call[]
  notifications       Notification[]
  tasks               Task[]    @relation("TaskAssignee")
  createdTasks        Task[]    @relation("TaskCreator")
  notes               Note[]
  meetings            Meeting[]
  outreachRecords     Outreach[]

  @@map("users")
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  managerId   String?  @map("manager_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  manager     User?    @relation("TeamManager", fields: [managerId], references: [id])
  members     User[]   @relation("TeamMembers")

  @@map("teams")
}

model Lead {
  id                String      @id @default(uuid())
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  email             String?
  phone             String?
  company           String?
  jobTitle          String?     @map("job_title")
  source            LeadSource  @default(csv_upload)
  status            String      @default("New Lead")
  dealValue         Float?      @map("deal_value")
  notes             String?
  tags              String[]    @default([])
  customFields      Json?       @map("custom_fields")

  // Company details
  website             String?
  companyLinkedinUrl   String?   @map("company_linkedin_url")
  companyPhone         String?   @map("company_phone")
  employeeCount        String?   @map("employee_count")
  city                 String?
  state                String?
  address              String?
  country              String?

  // Person details
  personLinkedinUrl    String?   @map("person_linkedin_url")
  workDirectPhone      String?   @map("work_direct_phone")
  mobilePhone          String?   @map("mobile_phone")
  homePhone            String?   @map("home_phone")
  corporatePhone       String?   @map("corporate_phone")
  otherPhone           String?   @map("other_phone")

  // Employees (embedded JSON — array of employee objects)
  employees            Json?     @default("[]")

  // Pipeline
  pipelineStageId      String?   @map("pipeline_stage_id")

  // Assignment
  uploadedById         String    @map("uploaded_by")
  assignedToId         String?   @map("assigned_to")
  assignedAt           DateTime? @map("assigned_at")

  // Follow-up / cadence
  nextFollowUp         DateTime? @map("next_follow_up")
  lastContactedAt      DateTime? @map("last_contacted_at")
  cadence              Json?

  // Qualification
  qualification        Json?
  priority             String?
  segment              String?
  sourceChannel        String?   @map("source_channel")

  // Active Account fields
  contractSignDate     DateTime? @map("contract_sign_date")
  activeServiceDate    DateTime? @map("active_service_date")
  assignedVA           String?   @map("assigned_va")

  // Soft delete
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at")
  deletedById          String?   @map("deleted_by")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  uploader             User      @relation("UploadedBy", fields: [uploadedById], references: [id])
  assignedTo           User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  pipelineStage        PipelineStage? @relation(fields: [pipelineStageId], references: [id])
  activities           Activity[]
  calls                Call[]
  notifications        Notification[]
  meetings             Meeting[]
  noteEntries          Note[]
  tasks                Task[]

  @@index([uploadedById])
  @@index([assignedToId])
  @@index([status])
  @@index([isDeleted])
  @@index([pipelineStageId])
  @@index([createdAt])
  @@map("leads")
}

model PipelineStage {
  id          String   @id @default(uuid())
  name        String   @unique
  order       Int
  color       String   @default("#6B7280")
  probability Int      @default(0)
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leads       Lead[]

  @@map("pipeline_stages")
}

model Activity {
  id            String       @id @default(uuid())
  leadId        String?      @map("lead_id")
  userId        String?      @map("user_id")
  type          ActivityType
  description   String?
  subject       String?

  // Call-specific
  callDuration  Int?         @map("call_duration")
  callOutcome   CallOutcome? @map("call_outcome")

  // Stage/status change
  fromStage     String?      @map("from_stage")
  toStage       String?      @map("to_stage")
  fromStatus    String?      @map("from_status")
  toStatus      String?      @map("to_status")

  // Scheduling
  scheduledAt   DateTime?    @map("scheduled_at")
  completedAt   DateTime?    @map("completed_at")
  isCompleted   Boolean      @default(false) @map("is_completed")

  metadata      Json?

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  lead          Lead?        @relation(fields: [leadId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])

  notifications Notification[]

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@map("activities")
}

model Call {
  id              String      @id @default(uuid())
  leadId          String      @map("lead_id")
  userId          String?     @map("user_id")
  leadName        String?     @map("lead_name")
  agentName       String?     @map("agent_name")
  date            DateTime    @default(now())
  time            String?
  duration        Int         @default(0)
  outcome         String?
  direction       String?     @default("outbound")
  contactNumber   String?     @map("contact_number")
  status          CallStatus  @default(Completed)
  notes           String?
  hasRecording    Boolean     @default(false) @map("has_recording")
  recordingUrl    String?     @map("recording_url")
  recordingFlagged Boolean    @default(false) @map("recording_flagged")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  lead            Lead        @relation(fields: [leadId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([date])
  @@map("calls")
}

model Meeting {
  id               String        @id @default(uuid())
  title            String
  description      String?
  scheduledAt      DateTime      @map("scheduled_at")
  time             String?
  duration         Int           @default(30)
  location         String?
  type             String?       @default("call")
  leadId           String?       @map("lead_id")
  leadName         String?       @map("lead_name")
  createdById      String?       @map("created_by")
  createdByName    String?       @map("created_by_name")
  attendees        String[]      @default([])
  status           MeetingStatus @default(scheduled)
  agenda           String?
  notes            String?
  confirmationSent Boolean       @default(false) @map("confirmation_sent")
  nextStep         String?       @map("next_step")
  outcome          String?
  ams              String?
  driveLink        String?       @map("drive_link")

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  lead             Lead?         @relation(fields: [leadId], references: [id])
  createdBy        User?         @relation(fields: [createdById], references: [id])

  @@map("meetings")
}

model Note {
  id        String   @id @default(uuid())
  leadId    String?  @map("lead_id")
  userId    String   @map("user_id")
  content   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead      Lead?    @relation(fields: [leadId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("notes")
}

model Notification {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  title           String
  message         String
  type            NotificationType @default(system)
  link            String?
  isRead          Boolean          @default(false) @map("is_read")
  readAt          DateTime?        @map("read_at")
  relatedLeadId   String?          @map("related_lead_id")
  relatedActivityId String?        @map("related_activity_id")

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  relatedLead     Lead?            @relation(fields: [relatedLeadId], references: [id])
  relatedActivity Activity?        @relation(fields: [relatedActivityId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  dueDate      DateTime?    @map("due_date")
  priority     TaskPriority @default(medium)
  status       TaskStatus   @default(pending)
  assignedToId String?      @map("assigned_to")
  createdById  String?      @map("created_by")
  leadId       String?      @map("lead_id")
  leadName     String?      @map("lead_name")
  category     String?
  completedAt  DateTime?    @map("completed_at")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([assignedToId, status])
  @@index([dueDate])
  @@map("tasks")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  userId      String?  @map("user_id")
  adminId     String?  @map("admin_id")
  adminEmail  String?  @map("admin_email")
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  targetId    String?  @map("target_id")
  targetEmail String?  @map("target_email")
  targetRole  String?  @map("target_role")
  ip          String?
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  meta        Json?
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}

model Outreach {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  emailsSent   Int      @default(0) @map("emails_sent")
  replies      Int      @default(0)
  bounced      Int      @default(0)
  dateSent     DateTime @default(now()) @map("date_sent")
  platform     String   @default("email")
  campaignName String?  @map("campaign_name")
  notes        String?

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("outreach")
}
