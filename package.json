{
  "name": "sales-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:start": "npx prisma dev -d && npx tsx server/scripts/wait-for-db.ts",
    "db:status": "npx prisma dev ls",
    "db:wait": "npx tsx server/scripts/wait-for-db.ts",
    "db:check": "npx tsx server/scripts/db-check.ts",
    "dev": "tsx watch server/index.ts",
    "dev:local": "npm run db:start && tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "seed:stages": "tsx server/seeds/pipelineStages.ts",
    "seed:admin": "tsx server/seeds/defaultAdmin.ts",
    "seed:all": "tsx server/seeds/pipelineStages.ts && tsx server/seeds/defaultAdmin.ts",
    "db:clean": "tsx server/seeds/cleanDb.ts",
    "build": "prisma generate && next build --webpack",
    "build:server": "prisma generate && npx esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --packages=external --sourcemap=inline",
    "start": "node dist/server.mjs",
    "start:local": "npm run db:start && npm run build:server && node dist/server.mjs",
    "start:dev": "tsx server/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
